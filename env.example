# Chỉ dùng PAPER trong bản miễn phí này
BOT_MODE=paper

# Thời gian giữa các lần kiểm tra giá
POLL_SECONDS=60

# Vốn mô phỏng ban đầu
START_BALANCE_USD=1000

# Coin theo dõi
ASSET=BTC

# Journal thống kê: chỉ ghi kết quả forward đã quan sát thực tế
STATISTICAL_HORIZON_MS=900000
STATISTICAL_MAX_SAMPLES=5000
STATISTICAL_JOURNAL_PATH=data/statistical-journal.jsonl

# Chỉ xác nhận edge khi có đủ dữ liệu thực nghiệm.
# Đây là tiêu chuẩn thống kê, không phải ngưỡng giá BUY/SELL.
STATISTICAL_MIN_SAMPLES=50
STATISTICAL_TEST_WINDOW=20
STATISTICAL_MIN_DIRECTIONAL_PROBABILITY=0.60
STATISTICAL_MIN_LOWER_BOUND_95=0.55
STATISTICAL_MIN_EXPECTED_VALUE_PCT=0.20

# Chi phí round-trip mô phỏng: fee + slippage của cả entry và exit.
STATISTICAL_ROUND_TRIP_COST_PCT=0.80

# Tuỳ chọn DEX read-only
DEX_NETWORK=
DEX_POOL_ADDRESS=
DEX_ASSET=
