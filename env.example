# Chỉ dùng PAPER trong bản miễn phí này
BOT_MODE=paper

# Thời gian giữa các lần kiểm tra giá
POLL_SECONDS=60

# Vốn mô phỏng ban đầu
START_BALANCE_USD=1000

# Coin theo dõi
ASSET=BTC

# Nếu giá giảm từ lần kiểm tra trước >= mức này thì mô phỏng BUY
BUY_DROP_PCT=2

# Nếu giá tăng >= mức này so với giá BUY thì mô phỏng SELL
SELL_RISE_PCT=3
