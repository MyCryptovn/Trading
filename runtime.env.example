# Runtime is PAPER ONLY. Never put private keys here.
BOT_MODE=paper
PORT=3000
POLL_SECONDS=60
START_BALANCE_USD=1000

# Market / DEX configuration
ASSET=BTC
DEX_NETWORK=
DEX_CHAIN_ID=
DEX_POOL_ADDRESS=
DEX_ASSET=
DEX_TOKEN_ADDRESS=

# Public/read-only data providers
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=

# GoPlus is required for any future live-trading authorization.
# Keep disabled in Paper until credentials are available.
PAPER_DISABLE_GOPLUS=true
GOPLUS_ACCESS_TOKEN=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Optional AI bridge
# Configure according to the TradingAgents runner requirements.
# Never store private wallet keys in environment variables.

# Persistent journals
PAPER_PERFORMANCE_PATH=/app/data/paper-performance.jsonl
STATISTICAL_JOURNAL_PATH=/app/data/statistical-journal.jsonl
